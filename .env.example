# Aether configuration. ./start.sh copies this to .env and fills in AETHER_SECRET_KEY for you.
# With no provider keys at all, Aether still runs end to end on its offline mock models.

# ---- Required -------------------------------------------------------------------------------
# Encrypts provider and endpoint secrets stored in the database. Keep it stable once set.
AETHER_SECRET_KEY=replace-with-a-long-random-string
AETHER_ORG_NAME="My Organization"

# ---- Ports ----------------------------------------------------------------------------------
# web UI and API
AETHER_PORT=8080
# sample tool APIs and external demo agents
SAMPLES_PORT=8100

# ---- Model providers (fill in any you have) ---------------------------------------------------
# OpenAI (or any OpenAI-compatible server via OPENAI_BASE_URL)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic
ANTHROPIC_API_KEY=
# An OpenAI-compatible LLM gateway / proxy used inside your company
GATEWAY_API_KEY=
GATEWAY_APP_NAME=
# GATEWAY_APP_HEADER=x-client-app
GATEWAY_OPENAI_BASE_URL=
GATEWAY_BEDROCK_BASE_URL=
GATEWAY_PERPLEXITY_BASE_URL=
# More providers (Azure OpenAI, Amazon Bedrock, Ollama, vLLM...) can be added in the UI under Models.

# LLM used by the two sample external agents (any OpenAI-compatible endpoint). Optional:
# without it they answer with simple built-in rules.
SAMPLE_LLM_BASE_URL=
SAMPLE_LLM_API_KEY=
SAMPLE_LLM_MODEL=
SAMPLE_LLM_HEADERS=

# ---- Authentication -------------------------------------------------------------------------
# none (local use) | api_key | oidc (Okta, Auth0, Entra ID, Keycloak, Google...)
AETHER_AUTH_MODE=none
# First admin key when auth is on (start.sh generates one). Must start with ak_
AETHER_BOOTSTRAP_API_KEY=
# AETHER_OIDC_ISSUER=https://your-org.okta.com/oauth2/default
# AETHER_OIDC_AUDIENCE=api://aether
# AETHER_OIDC_JWKS_URL=https://your-org.okta.com/oauth2/default/v1/keys

# ---- Corporate network ----------------------------------------------------------------------
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,.internal.example.com
# Extra CA certificates (PEM) for TLS inspection or internal endpoints: put the file in ./config
# and reference its path inside the containers:
# AETHER_CA_BUNDLE=/config/ca-bundle.pem

# ---- Scale ----------------------------------------------------------------------------------
AETHER_WORKERS=2
AETHER_WORKER_CONCURRENCY=12
